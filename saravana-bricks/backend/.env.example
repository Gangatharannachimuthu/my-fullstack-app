# Separate schema on the same MySQL server as Mandram. URL-encode special
# characters in the password (e.g. @ becomes %40).
DATABASE_URL=mysql+pymysql://root:your-password@localhost:3306/saravana_bricks_db
PORT=5002
DEBUG=False

# Set to True once the app is served over HTTPS.
SESSION_COOKIE_SECURE=False
SESSION_DAYS=7
INVOICE_PREFIX=SSB
